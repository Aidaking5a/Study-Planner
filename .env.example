# Kloer runs with a free local deterministic agent provider by default.
AGENT_PROVIDER=free
API_PORT=8788
WEB_ORIGIN=http://127.0.0.1:5173

# Future paid or open-source provider adapter.
# Keep this unset for the free beta.
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=

# Supabase-backed shared school intelligence.
# Leave these unset to use the local demo fallback.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# SUPABASE_RESULT_UPLOAD_BUCKET=test-result-uploads
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=browser-publishable-key
SCHOOL_INTELLIGENCE_MIN_CONFIDENCE=0.74
SCHOOL_INTELLIGENCE_MIN_EVIDENCE=3
